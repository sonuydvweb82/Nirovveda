# Nirovveda environment template
# Copy to .env and fill in real values.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nirovveda?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Backend server
PORT=5000

# AI service
AI_SERVICE_URL="http://localhost:8000"

# Frontend origin (CORS)
CORS_ORIGIN="http://localhost:5173"

# AI service keys (leave blank if using rule-based fallback)
OPENAI_API_KEY=""